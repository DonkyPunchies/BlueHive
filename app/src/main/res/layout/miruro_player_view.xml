<?xml version="1.0" encoding="utf-8"?>
<!--
    The anime player's PlayerView.

    Its control bar is now the SHARED one, player_controls.xml, rather than a
    private copy of media3's stock layout. The quality button it used to carry
    alone lives there too, declared GONE, and MiruroPlayerActivity reveals it.

    Every attribute is stated rather than inherited, matching hls_player_view:
    surface_type and auto_show were defaults before, and a default that changes
    under you is a behaviour change with no diff.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miruro_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:use_controller="true"
    app:resize_mode="fit"
    app:surface_type="surface_view"
    app:auto_show="true"
    app:keep_content_on_player_reset="false"
    app:controller_layout_id="@layout/player_controls" />
