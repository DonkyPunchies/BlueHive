<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml — standalone (2026-08-16)

    Entry point: .auth.AuthActivity, the only LEANBACK_LAUNCHER tile.
    AuthActivity → LoadingScreenActivity → ProfileScreenActivity →
    HomeScreenCompose, with AuthActivity deciding in onCreate whether a stored
    session lets it skip straight through.

    This replaced the host model, in which the sole entry was
    .host.HostEntryActivity behind an io.companion.host.action.LAUNCH intent and
    there was no launcher tile at all — BlueHive could not start without Off-Grid
    Drive installed and paired. Nothing in that path remains: the AIDL contract,
    the io.companion.host package and all four host classes are deleted, and
    BlueHive now authenticates directly against its own backend.
-->
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    >

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- §7.4 / Rule 8: required so BlueHive can hand a downloaded, sha256-
         verified APK to PackageInstaller for self-update. One-time user grant
         ("install unknown apps" toggle for BlueHive), then one confirm dialog
         per update — unavoidable on sideloaded stock Android. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets SpeechRecognizer locate the on-device recognition service on API 30+ -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Package-visibility entry for the host entitlement provider.
             Android 11+ hides other apps unless declared, and without this the
             provider read silently returns null.
             Declared BY AUTHORITY, never by package name: the authority states a
             capability any host could implement, so nothing here ties BlueHive to
             a particular vendor. A package name would. -->
        <provider android:authorities="io.host.entitlement.provider" />
        <!-- The BIND_HOST <queries> entry is gone with the companion contract.
             It existed so package-visibility rules on Android 11+ would let
             BlueHive discover and bind a host's ICompanionHost service. BlueHive
             binds nothing now — it authenticates directly against its own
             backend — so declaring the visibility would grant a capability the
             app no longer uses. -->
    </queries>

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application
        android:name=".BlueHiveApplication"
        android:networkSecurityConfig="@xml/${netSecConfig}"
        android:allowBackup="false"

        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:banner="@drawable/hive"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlueHive">

        <!-- THE FRONT DOOR (2026-08-16). BlueHive now has its own launcher tile.
             Until now the only exported entry was HostEntryActivity behind
             io.companion.host.action.LAUNCH, which meant the app could not be
             started at all without Off-Grid Drive installed and paired — a
             sideloaded copy showed no icon and had no way in.

             AuthActivity decides in onCreate, before drawing anything: a stored
             session goes straight to LoadingScreenActivity, otherwise the
             sign-in form. Composing first and redirecting after would guarantee
             a visible flash of the form for every returning user. -->
        <activity
            android:name=".auth.AuthActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <!-- LEANBACK_LAUNCHER is what an Android TV home screen looks for. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />

                <!-- LAUNCHER as well, and it is not redundant. Some TV boxes ship
                     a phone-style launcher, and anything resolving the plain
                     category — including packageManager.getLaunchIntentForPackage(),
                     which tries LAUNCHER before falling back to LEANBACK — finds
                     nothing without it. Measured on this device: LEANBACK resolved
                     to AuthActivity while LAUNCHER returned "No activity found".

                     This is how a host launches BlueHive now: the ordinary
                     launcher intent, exactly as it launches SmartTube. There is no
                     BlueHive-specific action to know about any more. -->
                <category android:name="android.intent.category.LAUNCHER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoadingScreenActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <!-- Phoenix relauncher for the sidebar Reboot button. android:process
             puts it in a SEPARATE process so it survives SidebarReboot killing
             the main process, then relaunches BlueHive via AuthActivity
             (front door = stored-session check + self-update check) and exits.
             exported=false — only BlueHive itself starts it. -->
        <activity
            android:name=".sidebarComponents.RebootActivity"
            android:process=":phoenix"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <!-- Settings (sidebar → Settings) and its Diagnostics page (version,
             connectivity, storage, Send Logs). Internal-only screens. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />
        <activity
            android:name=".diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />



        <!-- HostEntryActivity REMOVED 2026-08-16, with the rest of the companion
             contract. It was the only exported entry point, reachable solely via
             io.companion.host.action.LAUNCH, which meant BlueHive could not start
             without a paired host. AuthActivity above carries LEANBACK_LAUNCHER
             instead, so the app opens on its own.

             Its self-update check moved to AuthActivity rather than being deleted
             with it — that check is now the ONLY way a fielded TV learns a new
             version exists, since there is no host to orchestrate updates. -->

        <activity
            android:name=".sidebarComponents.LiveTvScreenActivity"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <activity
            android:name=".ProfileManageActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <activity
            android:name="com.example.bluehive.catalog.MediaCatalogActivity"
            android:exported="false"
            android:theme="@style/Theme.BlueHive" />


        <!--
            Workspace lockout screen — shown when the 6-active device cap is hit.
            Launched from BlueHiveApplication's LockoutBus listener with
            FLAG_NEW_TASK | FLAG_CLEAR_TASK whenever any platform API call
            returns 429. See LockoutActivity.kt for the full flow.
        -->


        <!-- ExoPlayer screen — MAIN process, full-screen. Plays the m3u8. -->
        <activity
            android:name=".webview.miruro.MiruroPlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation" />

        <!-- Headless extractor — its OWN process, translucent, kills itself when done. -->
        <activity
            android:name=".webview.miruro.MiruroExtractorActivity"
            android:exported="false"
            android:process=":extractor"
            android:screenOrientation="landscape"
            android:excludeFromRecents="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />



        <activity
            android:name=".webview.vidapi.VidApiExtractorActivity"
            android:exported="false"
            android:process=":vidapiextractor"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- VidFast m3u8 extraction moved to the backend (/api/extract). The
             on-device extractor and its :vidfastextractor process are gone: on a
             filtered line vidfast.vc is refused to every client on the device, so
             no amount of local retrying could work. VidApi above is unaffected —
             Movies still extract on-device through it. -->

        <activity
            android:name=".webview.hls.HlsPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />


        <activity
            android:name=".LockoutActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <!-- Account-standing lock. Separate from LockoutActivity above, which is
             the concurrent-device cap: that one is temporary and self-resolving,
             this one only changes when the subscription does. Raised with
             CLEAR_TASK from EntitlementLockBus, and re-checked at launch. -->
        <activity
            android:name=".auth.ServiceLockoutActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <activity
            android:name=".searchBarComponent.SearchBarActivity"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.BlueHive" />

        <!-- Profile picker (shown after login, every launch) -->
        <activity
            android:name=".ProfileScreenActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <!-- Profile creation (opened from ProfileScreen's create button) -->
        <activity
            android:name=".ProfileCreationActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.BlueHive" />

        <activity
            android:name=".sidebarComponents.HistoryScreenActivity"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <activity
            android:name=".sidebarComponents.FavoritesScreenActivity"
            android:exported="false"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <!-- Home screen (reached after profile is selected) -->
        <!-- AFTER -->
        <activity
            android:name=".HomeScreenCompose"
            android:exported="false"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing" />

        <activity
            android:name=".MoviesDetailsScreenCompose"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <activity
            android:name=".TVShowsDetailsScreenCompose"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <activity
            android:name=".webview.MainWebViewer"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="landscape"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.bluehive.tv.video"
            android:excludeFromRecents="false"
            android:exported="false"/>

        <!-- Self-update (#5): receives PackageInstaller status callbacks.
             exported=false — only our own PendingIntent targets it. -->
        <receiver
            android:name=".update.SelfUpdateInstallReceiver"
            android:exported="false" />

        <!-- Self-update (#5): the in-app "Updating BlueHive" screen shown at cold
             start when a newer version exists, before the app opens. -->
        <activity
            android:name=".update.SelfUpdateActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BlueHive" />

        <!-- Self-update (#5): auto-relaunch after the app is replaced. -->
        <receiver
            android:name=".update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>